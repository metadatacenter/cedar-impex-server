  "components" : {
    "schemas" : {
      "CadsrFileImportStatus" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "How the import of one uploaded file is going.",
        "properties" : {
          "fileName" : {
            "type" : "string",
            "description" : "The file's name, without any directory part."
          },
          "importStatus" : {
            "type" : "string",
            "description" : "Where the file's import stands: waiting to start, being translated, saved as a template, or failed.",
            "enum" : [ "PENDING", "IN_PROGRESS", "COMPLETE", "ERROR" ]
          },
          "report" : {
            "type" : "string",
            "description" : "The messages the translation produced, separated by line breaks. Empty until there are any."
          },
          "statusTime" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "When the status last changed."
          }
        },
        "required" : [ "fileName", "importStatus", "report", "statusTime" ]
      },
      "CadsrFormUploadChunk" : {
        "type" : "object",
        "description" : "One chunk of one file, sent as Flow.js sends it. An upload can hold several files, and each file arrives as one or more chunks. Every chunk repeats the fields that place it in its file and its file in the upload, and a chunk that disagrees with an earlier one is refused. Other form fields are ignored.",
        "properties" : {
          "file" : {
            "type" : "string",
            "format" : "binary",
            "description" : "The chunk's bytes, as the request's only file part."
          },
          "flowChunkNumber" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "This chunk's position in the file, counting from 1.",
            "minimum" : 1
          },
          "flowChunkSize" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The size in bytes of every chunk of the file except the last.",
            "maximum" : 5368709120,
            "minimum" : 1
          },
          "flowCurrentChunkSize" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The size in bytes of this chunk. It must match the chunk sent, and equals the chunk size for every chunk but the last, which holds what remains of the file.",
            "minimum" : 0
          },
          "flowFilename" : {
            "type" : "string",
            "description" : "The file's name. Any directory part is dropped, and no two files in one upload may have the same name."
          },
          "flowIdentifier" : {
            "type" : "string",
            "description" : "Identifies the file within the upload."
          },
          "flowRelativePath" : {
            "type" : "string",
            "description" : "The file's path on the client. It is required and otherwise unused."
          },
          "flowTotalChunks" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "How many chunks the file is sent in: its size divided by the chunk size, rounded either down or up.",
            "minimum" : 1
          },
          "flowTotalSize" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The file's size in bytes.",
            "maximum" : 5368709120,
            "minimum" : 0
          },
          "numberOfFiles" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "How many files the upload holds. The import starts once all of them have arrived.",
            "minimum" : 1
          },
          "uploadId" : {
            "type" : "string",
            "description" : "Identifies the upload. Every chunk of every file in the upload carries the same value, which must be a single path segment. The import status is reported under it."
          }
        },
        "required" : [ "file", "flowChunkNumber", "flowChunkSize", "flowCurrentChunkSize", "flowFilename", "flowIdentifier", "flowRelativePath", "flowTotalChunks", "flowTotalSize", "numberOfFiles", "uploadId" ]
      },
      "CadsrImportStatus" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "How the import of one upload is going, file by file.",
        "properties" : {
          "destinationCedarFolderId" : {
            "type" : "string",
            "description" : "The folder the templates are created in. It is null when the caller named no folder and has no home folder yet.",
            "nullable" : true
          },
          "filesImportStatus" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/CadsrFileImportStatus"
            },
            "description" : "Each file's import, keyed by file name."
          },
          "ownerUserId" : {
            "type" : "string",
            "description" : "The user who ran the import. No other user is shown it."
          },
          "uploadId" : {
            "type" : "string",
            "description" : "Identifies the upload, as its chunks named it."
          }
        },
        "required" : [ "destinationCedarFolderId", "filesImportStatus", "ownerUserId", "uploadId" ]
      },
      "CadsrImportStatusesByUpload" : {
        "type" : "object",
        "additionalProperties" : {
          "$ref" : "#/components/schemas/CadsrImportStatus"
        },
        "description" : "Every import the caller has run, keyed by upload identifier."
      },
      "CedarError" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "A CEDAR error response. Diagnostic fields are populated only when they are relevant to the failure.",
        "properties" : {
          "entities" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "object",
              "description" : "Named domain entities associated with exception-mapped errors.",
              "nullable" : true
            },
            "description" : "Named domain entities associated with exception-mapped errors.",
            "nullable" : true
          },
          "errorId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Correlation identifier for an internal error recorded in server logs.",
            "nullable" : true
          },
          "errorKey" : {
            "type" : "string",
            "description" : "Stable machine-readable error identifier.",
            "enum" : [ "templateElementNotCreated", "templateElementNotFound", "templateElementNotDeleted", "templateElementNotUpdated", "templateElementsNotListed", "templateFieldNotCreated", "templateFieldNotFound", "templateFieldNotDeleted", "templateFieldNotUpdated", "templateFieldsNotListed", "templateNotCreated", "templateNotFound", "templateNotDeleted", "templateNotUpdated", "templatesNotListed", "templateInstanceNotCreated", "templateInstanceNotFound", "templateInstanceNotDeleted", "templateInstanceNotUpdated", "templateInstancesNotListed", "noReadAccessToResource", "noWriteAccessToResource", "noReadAccessToFolder", "noWriteAccessToFolder", "noReadAccessToTemplate", "noWriteAccessToTemplate", "noReadAccessToTemplateElement", "noWriteAccessToTemplateElement", "noReadAccessToTemplateField", "noWriteAccessToTemplateField", "noReadAccessToTemplateInstance", "noWriteAccessToTemplateInstance", "noReadAccessToArtifact", "noWriteAccessToArtifact", "noReadAccessToCategory", "noWriteAccessToCategory", "folderNotFound", "artifactNotFound", "artifactPreconditionRequired", "artifactHasMovedOn", "verbatimWriteRefused", "nodeNotFound", "unknownResourceType", "missingParameter", "invalidInput", "sourceFolderNotFound", "sourceResourceNotFound", "targetFolderNotFound", "nodeNotMoved", "groupNotFound", "userNotFound", "uniqueConstraintCollision", "invalidData", "notAuthorized", "permissionMissing", "tokenInvalid", "userInfoLoadByTokenFailed", "userInfoLoadByApiKeyFailed", "cedarUserNotFound", "authorizationNotFound", "permissionNotOwned", "authorizationTypeUnknown", "apiKeyNotFound", "tokenMissing", "tokenExpired", "parentFolderNotSpecified", "parentFolderSpecifiedTwice", "pathNotNormalized", "parentFolderNotFound", "updateInvalidFolderName", "createInvalidFolderName", "nodeAlreadyPresent", "folderNotCreated", "missingNameAndDescription", "missingData", "folderNotDeleted", "artifactNotDeleted", "resourceNotCreated", "invalidResourceType", "invalidArtifactType", "readOtherProfileForbidden", "updateOtherProfileForbidden", "folderCanNotBeDeleted", "folderCanNotBeChanged", "groupAlreadyPresent", "groupCanBeModifiedOnlyByGroupAdmin", "groupCanBeDeletedOnlyByGroupAdmin", "groupMembersCanBeReadOnlyByGroupAdmin", "groupRequiresAdministrator", "groupUsersNotUpdated", "specialGroupCanNotBeDeleted", "folderPermissionsCanNotBeChanged", "unknownInstanceOutputFormat", "folderCopyNotAllowed", "methodNotImplemented", "upstreamServerError", "nothingToDo", "parentCategoryNotFound", "categoryAlreadyPresent", "categoryNotFound", "categoryCanNotBeDeleted", "rootCategoryCanNotBeDeleted", "unableToAttachCategory", "unableToDetachCategory", "noCategoriesWereAttached", "malformedJsonRequestBody", "malformedSearchTerm", "publishedArtifactCanNotBeChanged", "publishedArtifactCanNotBeDeleted", "versioningOnlyOnLatest", "versioningOnlyByOwner", "nonVersionedArtifactType", "createDraftOnlyFromPublished", "publishOnlyDraft", "draftNotCreated", "contentNotValid", "doiNotSupportedByResourceType", "doiCanNotBeSetForEmptyAtId", "doiCanNotBeAltered", "doiCanNotBeSet", "doiAlreadyExists", "dataCiteDOIDisabled", "pinnedVersionUnavailable", "resourceNotFound", "rateLimitExceeded", "rateLimitUnavailable", "internalError" ],
            "nullable" : true
          },
          "errorReasonKey" : {
            "type" : "string",
            "description" : "More specific machine-readable reason for the error.",
            "enum" : [ "nonEmptyFolder", "nonEmptyCategory", "userHomeFolder", "systemFolder", "templateReferencedInInstances", "validationError", "continuationExpired" ],
            "nullable" : true
          },
          "errorType" : {
            "type" : "string",
            "description" : "Broad category of the error.",
            "enum" : [ "notFound", "invalidArgument", "authorization", "permission", "server", "validationError" ],
            "nullable" : true
          },
          "message" : {
            "type" : "string",
            "description" : "Human-readable error message.",
            "nullable" : true
          },
          "objects" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "object",
              "description" : "Named structured values associated with the error."
            },
            "description" : "Named structured values associated with the error."
          },
          "operation" : {
            "type" : "object",
            "description" : "Operation that failed. Its fields depend on the operation type.",
            "nullable" : true
          },
          "parameters" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "object",
              "description" : "Named scalar values associated with the error."
            },
            "description" : "Named scalar values associated with the error."
          },
          "status" : {
            "type" : "string",
            "description" : "Symbolic HTTP response status, or HTTP_<code> for an unnamed status.",
