{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "Better Metadata - Better Science\n\nFolders and artifacts use type-qualified selectors: `folders/<uuid>`, `templates/<uuid>`,\n`template-elements/<uuid>`, `template-fields/<uuid>`, or `template-instances/<uuid>`.\nTyped routes include the type once, for example `/templates/<uuid>`. Query parameters and\ncommand-body selectors retain the type, including folder parameters. Percent-encoded full\nIRIs remain accepted for compatibility. Stored document identities and references remain\nfull IRIs; legacy repository hosts must remain absolute until their data is migrated.\n\nThe impex server brings metadata into CEDAR from outside it. Today that means caDSR forms:\nXML uploaded in chunks, translated into CEDAR templates, and saved into a folder of the caller's\nchoosing.\n\nTranslation runs in the background, so an upload returns before the templates exist. The status\nendpoint is how a caller learns what became of each file.\n",
    "title" : "CEDAR Impex Server API",
    "version" : "2.9.28"
  },
  "paths" : {
    "/" : {
      "get" : {
        "operationId" : "showInfo",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object"
                }
              }
            },
            "description" : "The service name and links to its API documentation"
          }
        },
        "summary" : "Describe this CEDAR service",
        "tags" : [ "Service" ]
      }
    },
    "/command/import-cadsr-forms" : {
      "post" : {
        "description" : "Upload one or more caDSR XML forms, a chunk per request, and translate each into a CEDAR template. The upload is chunked, so a caller sends this repeatedly; the import starts by itself once the last chunk of an upload arrives. Translation then runs in the background, so a 200 means the chunk was stored and any import it completed was started, not that a template exists yet. Poll the import status to find out how it went.",
        "operationId" : "importCadsrForm",
        "parameters" : [ {
          "description" : "Folder the templates are created in. Defaults to the caller's home folder.",
          "in" : "query",
          "name" : "folderId",
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "$ref" : "#/components/schemas/CadsrFormUploadChunk"
              }
            }
          },
          "description" : "One chunk of one file, with the fields that place it in its upload",
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "The chunk was stored; any import it completed has been started"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The request is not a multipart upload, or the chunk is refused because an upload field is missing or malformed or the chunk disagrees with the upload it belongs to. A refused chunk's message names the problem."
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The request carries no valid credentials"
          },
          "406" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The request does not accept a JSON response"
          },
          "415" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The body is not declared as multipart/form-data"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The deployment limits each user's request rate, and the caller exceeded it"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The multipart request could not be read, which the message reports, or the chunk could not be stored. The body's errorId identifies the failure in the server log."
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The graph database, or another service the request depends on, is unavailable"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Upload caDSR forms and import them as templates",
        "tags" : [ "caDSR import" ]
      }
    },
    "/command/import-cadsr-forms-status" : {
      "get" : {
        "description" : "Report how an import is going, file by file: pending, in progress, complete, or in error, with the messages the translation produced. Without an upload identifier it reports every import the caller has run. Scoped to the caller either way, and an upload belonging to someone else is reported as not found rather than refused, so this cannot be used to discover another user's imports.",
        "operationId" : "importStatus",
        "parameters" : [ {
          "description" : "Upload identifier. Omit it to get every import the caller has run.",
          "in" : "query",
          "name" : "uploadId",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "oneOf" : [ {
                    "$ref" : "#/components/schemas/CadsrImportStatus"
                  }, {
                    "$ref" : "#/components/schemas/CadsrImportStatusesByUpload"
                  } ]
                }
              }
            },
            "description" : "With an upload identifier, that upload's status. Without one, every import the caller has run, keyed by upload identifier."
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The request carries no valid credentials"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The caller has no upload with this identifier"
          },
          "406" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The request does not accept a JSON response"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The deployment limits each user's request rate, and the caller exceeded it"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Internal server error"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The graph database, or another service the request depends on, is unavailable"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Get the status of a caDSR import",
        "tags" : [ "caDSR import" ]
      }
    },
