<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.metadatacenter</groupId>
    <artifactId>cedar-impex-server</artifactId>
    <version>2.9.29</version>
  </parent>

  <groupId>org.metadatacenter</groupId>
  <artifactId>cedar-impex-server-core</artifactId>
  <packaging>jar</packaging>

  <name>CEDAR ImpEx Server Core</name>

  <properties>
    <!-- Line coverage measured on 2026-10-19: 81.6%. The build fails below this floor. -->
    <cedar.coverage.line.minimum>0.79</cedar.coverage.line.minimum>
  </properties>

  <dependencies>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-fileupload2-jakarta-servlet6</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- The classes generated below from src/main/resources/xsd carry jakarta.xml.bind annotations,
         so this module needs a JAXB runtime of its own. Bytecode analysis reports it unused because
         the runtime is found through a service lookup, not referenced. -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-rest-library</artifactId>
    </dependency>

    <!-- Carries the OpenAPI annotations on the import-status beans the status route serializes.
         Jackson introspection alone describes them as open objects whose keys may be absent, which
         leaves the route's two answers indistinguishable. Documentation only: no runtime code reads
         them. Version managed in cedar-parent. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- jsonchema2pojo generates Java classes from JSON Schema documents -->
      <plugin>
        <groupId>org.jsonschema2pojo</groupId>
        <artifactId>jsonschema2pojo-maven-plugin</artifactId>
        <configuration>
          <sourceDirectory>${basedir}/src/main/resources/json-schema</sourceDirectory>
          <targetPackage>org.metadatacenter.impex</targetPackage>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- JAXB generates Java classes from XML Schema documents. The 4.x jvnet plugin emits the
           jakarta.xml.bind namespace (the old org.jvnet.jaxb2.maven2 plugin emitted javax.xml.bind),
           which is what cedar-impex-server-application already expects and what the jaxb-runtime
           managed in cedar-parent supplies. -->
      <plugin>
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-maven-plugin</artifactId>
        <configuration>
          <schemaDirectory>${basedir}/src/main/resources/xsd</schemaDirectory>
          <!-- <generatePackage>org.metadatacenter.impex</generatePackage> -->
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Tell an IDE to include generated code in its compile phase. jsonschema2pojo uses ${basedir}/target/java-gen -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>test</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${basedir}/target/java-gen</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- The coverage report leaves out generated classes. jsonschema2pojo writes its classes
           directly into org.metadatacenter.impex, which holds no hand-written class, and xjc
           writes the NCBI schema classes into top-level packages of their own. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <!-- On the plugin rather than one execution, so the report and the coverage check count the
             same classes. -->
        <configuration>
          <excludes>
            <exclude>org/metadatacenter/impex/*.class</exclude>
            <exclude>bioproject/**</exclude>
            <exclude>biosample/**</exclude>
            <exclude>common/**</exclude>
            <exclude>generated/**</exclude>
          </excludes>
        </configuration>
      </plugin>

    </plugins>

  </build>

</project>
